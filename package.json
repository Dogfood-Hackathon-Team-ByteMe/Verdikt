{
  "name": "verdikt",
  "private": true,
  "description": "Verdikt: open, self-hostable hackathon submissions and judging.",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "test": "npm run test --workspace=src/backend",
    "acceptance": "node scripts/acceptance-report.mjs",
