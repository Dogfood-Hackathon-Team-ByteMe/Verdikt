# Copy to .env for local development. docker-compose sets these itself.

# Where the API listens.
PORT=8080

# MongoDB connection string. The bundled docker-compose runs a single-node
# replica set, which is what makes multi-document transactions work.
MONGO_URI=mongodb://localhost:27017/dogfood

# Browser origins allowed to send cookie-bearing requests, comma separated.
# Must name the frontend explicitly: the CORS spec forbids "*" with credentials.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# 'lax' suits a same-site frontend. Cross-site needs 'none', which requires HTTPS.
COOKIE_SAMESITE=lax

# Set to production to mark the session cookie Secure (HTTPS only).
NODE_ENV=development

# Password given to every seeded demo account.
SEED_PASSWORD=dogfood2026
